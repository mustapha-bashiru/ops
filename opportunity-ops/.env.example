# Copy to .env. Never commit the real .env — it holds live credentials.

# --- Extraction ---------------------------------------------------------
# Unset (default): deterministic regex extractor. Reproducible, no model calls.
# gemini: route fact extraction through a model. The verifier still gates every action.
EXTRACTOR=

# api (default) uses GEMINI_API_KEY. vertex uses GOOGLE_CLOUD_PROJECT + Application
# Default Credentials, which is the path Cloud Run uses via its service account.
# GEMINI_MODEL must name Gemini 3.5 or newer; the providers reject older generations.
MODEL_MODE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Vertex AI (MODEL_MODE=vertex only) ---------------------------------
GOOGLE_CLOUD_LOCATION=us-central1
# Optional local override. Leave empty to use Application Default Credentials
# ("gcloud auth application-default login"). Cloud Run needs neither: it obtains a
# short-lived token from the metadata server. Never commit a real token.
GOOGLE_ACCESS_TOKEN=

# --- Runtime ------------------------------------------------------------
# memory | cloud | unset (no persistence)
PERSISTENCE=memory
GOOGLE_CLOUD_PROJECT=local-demo
OPPORTUNITY_OPS_BUCKET=local-demo-bucket
PORT=3002

# --- Optional -----------------------------------------------------------
# Fetch a live opportunity page instead of the built-in fixture (npm run demo).
SOURCE_URL=
# deadline-conflict seeds a wrong claim to prove the verifier blocks the action.
DEMO_SCENARIO=
